{
  "build": {
    "commands": [
      "mvn -q -B -DskipTests clean compile dependency:build-classpath -DincludeScope=runtime -Dmdep.outputFile=target/classpath.txt 2>&1"
    ],
    "timeout": 120000
  },
  "run": {
    "command": "java -cp \"target/classes:$(cat target/classpath.txt)\" pricing.Main",
    "timeout": 10000
  }
}
